# Copy to .env, or create it in one step:
#   echo "PHONEBOOK_DOC_ID=$(pnpm -s gen:phonebook-id)" > .env
#
# The shared phonebook holding every peer's name and avatar. Keep the same id
# between runs: a fresh one is a brand new, empty phonebook. Share it with the
# people you want in yours. It is not a secret and not an access-control
# mechanism. The phonebook is unencrypted and anyone holding the id can edit
# it.
PHONEBOOK_DOC_ID=

# Optional sync server overrides. Unset uses the public keyhive sync server.
# SYNC_SERVER=ws://localhost:3030
# SYNC_SERVER_CONTACT_CARD=
# SYNC_SERVER_PEER_ID=
